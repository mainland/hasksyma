+          $CABAL v2-build $ARG_COMPILER --disable-tests --disable-benchmarks --dependencies-only -j2 $TARGET_CORE
+          $CABAL v2-build $ARG_COMPILER $ARG_TESTS $ARG_BENCH --dependencies-only -j2 $TARGET_CORE $TARGET_TEST
       - name: build w/o tests
         run: |
