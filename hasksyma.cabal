name:          hasksyma
version:       0.1
cabal-version: >= 1.10
license:       BSD3
license-file:  LICENSE
copyright:     (c) 2023 Drexel University
author:        Geoffrey Mainland <mainland@drexel.edu>
maintainer:    Geoffrey Mainland <mainland@drexel.edu>
stability:     alpha
homepage:      https://github.com/mainland/hasksyma
category:      Language
synopsis:      Symbolic expressions
tested-with:   GHC==9.2.8

description:
  Symbolic expressions.

build-type: Simple

flag cyclotomic
    description: Enable support for cyclotomic numbers
    manual: True
    default: False

library
  default-language: Haskell2010

  exposed-modules:
    Hasksyma
    Hasksyma.Const
    Hasksyma.Diff
    Hasksyma.Eval
    Hasksyma.Exp
    Hasksyma.Integrate
    Hasksyma.LaTeX
    Hasksyma.Pretty
    Hasksyma.Simplify

  build-depends:
    base            >= 4.12  && < 4.17,
    containers      >= 0.6   && < 0.7,
    ihaskell        >= 0.10  && < 0.11,
    mainland-pretty >= 0.7   && < 0.8,
    symbol          >= 0.2.4 && < 0.3,
    text            >= 1.2   && < 1.3,
    HaTeX           >= 3.21  && < 3.23,
    QuickCheck      >= 2.13  && < 2.15

  ghc-options:
    -Wall

  if flag(cyclotomic)
    cpp-options: -DCYCLOTOMIC
    build-depends: cyclotomic >= 1.1 && < 1.2

test-suite full
  type: exitcode-stdio-1.0
  main-is: Main.hs
  default-language: Haskell2010
  hs-source-dirs:
    test

  other-modules:
    Test.Const
    Test.Diff
    Test.Eval
    Test.Exact
    Test.Integrate
    Test.Simplify

  build-depends:
    hasksyma,
    base            >= 4.12 && < 4.17,
    hspec           >= 2.9  && < 2.10,
    hspec-core      >= 2.9  && < 2.10,
    mainland-pretty >= 0.7  && < 0.8,
    HUnit           >= 1.6  && < 1.7,
    QuickCheck      >= 2.13 && < 2.15

source-repository head
  type:     git
  location: https://github.com/mainland/hasksyma.git
