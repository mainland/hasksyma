name:          hasksyma
version:       0.1
cabal-version: >= 1.10
license:       BSD3
license-file:  LICENSE
copyright:     (c) 2023 Drexel University
author:        Geoffrey Mainland <mainland@drexel.edu>
maintainer:    Geoffrey Mainland <mainland@drexel.edu>
stability:     alpha
homepage:      https://github.com/mainland/hasksyma
category:      Language
synopsis:      Symbolic expressions
tested-with:   GHC==9.2.8,
               GHC==9.4.8,
               GHC==9.6.7,
               GHC==9.8.4,
               GHC==9.10.3,
               GHC==9.12.2

description:
  Symbolic expressions.

build-type: Simple

flag cyclotomic
    description: Enable support for cyclotomic numbers
    manual: True
    default: False

flag partial-evaluation
    description: Enable partial evaluation in Exp instances
    manual: True
    default: True

library
  default-language: Haskell2010

  exposed-modules:
    Hasksyma
    Hasksyma.Const
    Hasksyma.Diff
    Hasksyma.Eval
    Hasksyma.Exp
    Hasksyma.Integrate
    Hasksyma.LaTeX
    Hasksyma.Pretty
    Hasksyma.Simplify

  build-depends:
    base            >= 4.12  && < 4.22,
    containers      >= 0.6   && < 0.9,
    ihaskell        >= 0.10  && < 0.14,
    mainland-pretty >= 0.7   && < 0.8,
    symbol          >= 0.2.4 && < 0.3,
    text            >= 1.2   && < 2.2,
    HaTeX           >= 3.21  && < 3.24,
    QuickCheck      >= 2.13  && < 2.18

  ghc-options:
    -Wall

  if flag(cyclotomic)
    cpp-options: -DCYCLOTOMIC
    build-depends: cyclotomic >= 1.1 && < 1.2

  if flag(partial-evaluation)
    cpp-options: -DPEVAL

test-suite full
  type: exitcode-stdio-1.0
  main-is: Main.hs
  default-language: Haskell2010
  hs-source-dirs:
    test

  other-modules:
    Test.Const
    Test.Diff
    Test.Eval
    Test.Exact
    Test.Integrate
    Test.PEval
    Test.Simplify

  build-depends:
    hasksyma,
    base            >= 4.12 && < 4.22,
    hspec           >= 2.9  && < 2.12,
    hspec-core      >= 2.9  && < 2.12,
    mainland-pretty >= 0.7  && < 0.8,
    HUnit           >= 1.6  && < 1.7,
    QuickCheck      >= 2.13 && < 2.18

source-repository head
  type:     git
  location: https://github.com/mainland/hasksyma.git
